digraph ProbTFDemoCurrentArchitecture {
  graph [
    rankdir=LR,
    compound=true,
    newrank=true,
    bgcolor="white",
    fontname="DejaVu Sans",
    fontsize=18,
    label="ProbTF-demo Current Native v2 Architecture (through main@74b8ea5, 2026-07-13)",
    labelloc=t,
    labeljust=l,
    nodesep=0.35,
    ranksep=0.75,
    pad=0.25,
    splines=polyline
  ];

  node [
    shape=box,
    style="rounded,filled",
    fillcolor="white",
    color="#475569",
    fontname="DejaVu Sans",
    fontsize=10,
    margin="0.12,0.08"
  ];
  edge [
    color="#64748b",
    fontcolor="#334155",
    fontname="DejaVu Sans",
    fontsize=9,
    arrowsize=0.7
  ];

  subgraph cluster_code {
    label="Package ownership and code layers";
    color="#94a3b8";
    style="rounded,dashed";

    integrated_setup [
      shape=folder,
      fillcolor="#f8fafc",
      label="Integrated setuptools distribution\ncollects package-owned src roots\n(no root src relay)"
    ];

    subgraph cluster_core_owner {
      label="catkin owner: probtf_core/src";
      color="#3b82f6";
      style="rounded,filled";
      fillcolor="#eff6ff";

      distributions [
        fillcolor="#dbeafe",
        label="probtf.distributions\nBingham finite / Dirac / uniform\nconditional Gaussian translation\njoint component mixture"
      ];
      provenance [
        fillcolor="#dbeafe",
        label="probtf.provenance\nsource + derived edge IDs\ntyped approximation / loss"
      ];
      geometry [
        fillcolor="#dbeafe",
        label="probtf.geometry + bingham\nwxyz quaternion\ncolumn-major vec(R)\nself-contained Bingham numerics"
      ];
      graph_core [
        fillcolor="#dbeafe",
        label="probtf.graph + temporal\nlocked TF-style forest\nbounded edge histories\nEXACT / NEAREST / LATEST / LATEST_COMMON"
      ];
      kernels [
        fillcolor="#dbeafe",
        label="probtf.kernels\nlazy forward / inverse / mixture / composed\ndependency diagnostics"
      ];
      moments [
        fillcolor="#dbeafe",
        label="probtf.probability.moments\ncoupled point first/second moments"
      ];
      sampling [
        fillcolor="#dbeafe",
        label="probtf.probability.sampling\nfinite / uniform / Dirac Bingham\nmixture + coupled translation\nforward / inverse point samples"
      ];
      spherical [
        fillcolor="#dbeafe",
        label="probtf.spherical_law\ninduced direction/vector protocol\nexact special cases + tangent surrogate"
      ];
      support [
        fillcolor="#dbeafe",
        label="sensor config + mount\nsymbolic URDF\ndeterministic composition"
      ];

      estimator_imu [
        fillcolor="#dcfce7",
        label="probtf_estimators\nIMU kinematics + relative pose\nrotation/translation coupling"
      ];
      estimator_orientation [
        fillcolor="#fef3c7",
        label="probtf_estimators\norientation filter + evidence fusion\norientation-only domain"
      ];
      estimator_materialization [
        fillcolor="#dcfce7",
        label="materialization summary\nterminal point moments + mode gates"
      ];

      ros_v2 [
        fillcolor="#bfdbfe",
        label="probtf_ros\nv2 lossless conversion\nbroadcaster / listener\nTF import/export bridge"
      ];

      distributions -> geometry [label="conventions"];
      distributions -> provenance [label="component metadata"];
      graph_core -> distributions [label="stores records"];
      graph_core -> provenance [label="time/topology diagnostics"];
      kernels -> graph_core [label="path + resolved records"];
      kernels -> moments [label="MOMENTS"];
      kernels -> sampling [label="SAMPLES"];
      kernels -> spherical [label="NUMERICAL_LAW"];
      moments -> distributions [label="joint law moments"];
      sampling -> distributions [label="native law samples"];
      spherical -> distributions [label="orientation law"];
      support -> geometry;

      estimator_imu -> distributions [label="full SE(3) record"];
      estimator_imu -> geometry;
      estimator_orientation -> geometry [label="Bingham natural parameters"];
      estimator_orientation -> provenance;
      estimator_materialization -> kernels [label="point summary"];
      ros_v2 -> graph_core [label="local graph"];
      ros_v2 -> distributions [label="wire conversion"];
    }

    subgraph cluster_message_owner {
      label="catkin owner: probtf_msgs";
      color="#0ea5e9";
      style="rounded,filled";
      fillcolor="#f0f9ff";

      se3_messages [
        shape=component,
        fillcolor="#e0f2fe",
        label="Full SE(3) v2 wire\nProbabilisticTransformStamped / Array\nComponent + Orientation + Translation\nApproximation + Provenance"
      ];
      estimator_messages [
        shape=component,
        fillcolor="#fef3c7",
        label="Estimator v2 wire\nImuKinematics\nTransformEvidenceStamped\nOrientationDistributionStamped"
      ];
      no_v1 [
        shape=note,
        color="#16a34a",
        fillcolor="#dcfce7",
        label="ProbTF v1 removed\nNo ProbabilisticTF / Array\nNo GaussianPosition\nNo BinghamDistribution\nNo legacy adapters"
      ];
    }

    subgraph cluster_app_owners {
      label="Application-owned packages";
      color="#a855f7";
      style="rounded,filled";
      fillcolor="#faf5ff";

      imu_pkg [
        shape=component,
        fillcolor="#dcfce7",
        label="probtf_imu_demo\ntwo-IMU producer\nsymbolic URDF materializer"
      ];
      orientation_pkg [
        shape=component,
        fillcolor="#fef3c7",
        label="probtf_orientation_demo\norientation-only filter / fusion"
      ];
      symaware_pkg [
        shape=component,
        fillcolor="#fce7f3",
        label="symaware_grasp\nnative v2 config / composition / IK\n6 application messages"
      ];
      deflecomp_pkg [
        shape=component,
        fillcolor="#ede9fe",
        label="deflecomp packages\nWEKF + control + simulation\nscoped v2 TF consumer"
      ];

      imu_pkg -> estimator_imu;
      imu_pkg -> estimator_materialization;
      orientation_pkg -> estimator_orientation;
      symaware_pkg -> distributions [label="native v2 law"];
      symaware_pkg -> kernels [label="lookup/evaluate"];
      symaware_pkg -> sampling [label="terminal visualization"];
      deflecomp_pkg -> geometry [label="robot math"];
      deflecomp_pkg -> ros_v2 [label="scoped listener"];
    }

    ros_v2 -> se3_messages [label="primary transport"];
    estimator_orientation -> estimator_messages [label="orientation wire"];
    estimator_imu -> estimator_messages [label="kinematics wire"];
    imu_pkg -> se3_messages [label="publishes"];
    symaware_pkg -> se3_messages [label="publishes / embeds"];
    no_v1 -> se3_messages [style=dashed, arrowhead=none, label="native v2 only"];

    integrated_setup -> distributions [style=dotted, label="non-catkin packaging"];
    integrated_setup -> symaware_pkg [style=dotted];
    integrated_setup -> deflecomp_pkg [style=dotted];
  }

  subgraph cluster_runtime {
    label="Runtime dataflows";
    color="#334155";
    style="rounded,dashed";

    subgraph cluster_global_bus {
      label="Global native v2 transport";
      color="#2563eb";
      style="rounded,filled";
      fillcolor="#eff6ff";

      tf_bus [
        shape=ellipse,
        fillcolor="#dcfce7",
        label="/tf\n/tf_static"
      ];
      generic_bridge [
        fillcolor="#dbeafe",
        label="probtf_bridge_node\nTF import/export policy\nauthority + loop guard\noptional child-prefix filter"
      ];
      global_dynamic [
        shape=ellipse,
        fillcolor="#bfdbfe",
        label="/probtf\nProbabilisticTransformStamped\ndynamic full SE(3) records"
      ];
      global_static [
        shape=ellipse,
        fillcolor="#bfdbfe",
        label="/probtf_static\nlatched full static v2 set"
      ];
      local_listener [
        fillcolor="#dbeafe",
        label="RosProbTfListener per consumer\nbounded local ProbTfGraph\nwait / path / kernel / point moments"
      ];

      tf_bus -> generic_bridge [dir=both, label="deterministic import\nexplicit representative export"];
      generic_bridge -> global_dynamic [dir=both, label="dynamic v2"];
      generic_bridge -> global_static [dir=both, label="static v2"];
      global_dynamic -> local_listener [penwidth=2.0, label="subscribe"];
      global_static -> local_listener [penwidth=2.0, label="subscribe"];
    }

    subgraph cluster_two_imu {
      label="Two-IMU full SE(3) producer";
      color="#22c55e";
      style="rounded,filled";
      fillcolor="#f0fdf4";

      imu_inputs [
        shape=ellipse,
        fillcolor="white",
        label="/imu_parent/data\n/imu_child/data"
      ];
      kinematics_nodes [
        fillcolor="#dcfce7",
        label="2 x imu_kinematics_node\nlocal polynomial fit"
      ];
      kinematics_bus [
        shape=ellipse,
        fillcolor="#dcfce7",
        label="2 x ImuKinematics"
      ];
      relative_pose [
        fillcolor="#dcfce7",
        label="imu_relative_pose_node\nBingham + information RLS\ncoupled v2 component"
      ];
      materializer [
        fillcolor="#dcfce7",
        label="symbolic_urdf_materializer\nterminal point-moment / mode gates"
      ];
      robot_description [
        shape=note,
        fillcolor="white",
        label="/robot_description\nmaterialized URDF + RSP"
      ];

      imu_inputs -> kinematics_nodes [penwidth=2.0];
      kinematics_nodes -> kinematics_bus -> relative_pose [penwidth=2.0];
      relative_pose -> global_dynamic [penwidth=2.2, color="#16a34a", label="native full v2 edge"];
      global_dynamic -> materializer [color="#16a34a", label="direct v2 record"];
      materializer -> robot_description;
    }

    subgraph cluster_orientation_only {
      label="Orientation-only runtime (not an SE(3) graph)";
      color="#eab308";
      style="rounded,filled";
      fillcolor="#fefce8";

      orientation_inputs [
        shape=ellipse,
        fillcolor="white",
        label="/imu/data\n/imu/mag"
      ];
      orientation_filter [
        fillcolor="#fef3c7",
        label="orientation_filter_node\ngyro closure + exact vector likelihoods"
      ];
      evidence_bus [
        shape=ellipse,
        fillcolor="#fde68a",
        label="prediction / gravity / magnetic\nTransformEvidenceStamped"
      ];
      evidence_fusion [
        fillcolor="#fef3c7",
        label="probtf_fusion_node\nsource-aware natural-parameter sum"
      ];
      orientation_bus [
        shape=ellipse,
        fillcolor="#fde68a",
        label="posterior_orientation\nfused_orientation\nOrientationDistributionStamped\n(no translation field)"
      ];
      fake_translation_guard [
        shape=octagon,
        color="#dc2626",
        fontcolor="#991b1b",
        fillcolor="#fef2f2",
        label="Forbidden\nNo fake zero translation"
      ];

      orientation_inputs -> orientation_filter [penwidth=2.0];
      orientation_filter -> evidence_bus [penwidth=2.0];
      evidence_bus -> evidence_fusion [penwidth=2.0];
      orientation_filter -> orientation_bus [label="filter posterior"];
      evidence_fusion -> orientation_bus [label="fused posterior"];
      orientation_bus -> fake_translation_guard [color="#dc2626", arrowhead=tee];
      fake_translation_guard -> global_dynamic [style=dashed, color="#dc2626", arrowhead=none, label="intentionally not published"];
    }

    subgraph cluster_symaware_runtime {
      label="Symaware grasp: global graph plus application topics";
      color="#ec4899";
      style="rounded,filled";
      fillcolor="#fdf2f8";

      static_config [
        fillcolor="#fce7f3",
        label="native v2 YAML loader\n7 arm static edges"
      ];
      object_producer [
        fillcolor="#fce7f3",
        label="object pose producer\nPRODUCER_SUPPLIED law"
      ];
      hand_producer [
        fillcolor="#fce7f3",
        label="hand belief producer\nlossy MOMENT_SUMMARY fit"
      ];
      grasp_composer [
        fillcolor="#fce7f3",
        label="grasp target composer\ndeterministic right composition\nmixture + coupling + provenance"
      ];
      app_topics [
        shape=ellipse,
        fillcolor="#fbcfe8",
        label="/symaware_grasp/object_belief\n/hand_belief\n/grasp_targets\n/selected_target\nEach embeds complete v2 payload"
      ];
      symaware_listener [
        fillcolor="#fce7f3",
        label="RosProbTfListener consumers\nexact/latest direct-edge lookup"
      ];
      ik [
        fillcolor="#fce7f3",
        label="symmetry-aware IK\nall mixture components\ncoupled point moments\n+ deterministic baseline"
      ];
      visualizers [
        fillcolor="#fce7f3",
        label="link cloud + belief visualizers\npoint moments or native v2 samples\nterminal PointCloud2 / markers"
      ];

      static_config -> global_static [penwidth=2.2, color="#db2777", label="native static set"];
      object_producer -> global_dynamic [penwidth=2.0, color="#db2777", label="object edge"];
      hand_producer -> global_dynamic [penwidth=2.0, color="#db2777", label="hand edge"];
      object_producer -> app_topics;
      hand_producer -> app_topics;
      app_topics -> grasp_composer [label="names object edge"];
      global_dynamic -> symaware_listener [color="#db2777"];
      global_static -> symaware_listener [color="#db2777"];
      symaware_listener -> grasp_composer [style=dashed, label="exact graph record"];
      grasp_composer -> global_dynamic [penwidth=2.0, color="#db2777", label="derived target edges"];
      grasp_composer -> app_topics;
      app_topics -> ik [penwidth=2.0];
      symaware_listener -> ik [style=dashed, label="lookup kernels"];
      app_topics -> visualizers;
      symaware_listener -> visualizers [style=dashed, label="point moments / records"];
    }

    subgraph cluster_deflecomp_runtime {
      label="Deflecomp scoped v2 frame mirror";
      color="#8b5cf6";
      style="rounded,filled";
      fillcolor="#f5f3ff";

      deflecomp_control [
        fillcolor="#ede9fe",
        label="deflecomp WEKF + control\nref -> cmd -> equil"
      ];
      stiffness_topics [
        shape=ellipse,
        fillcolor="#ede9fe",
        label="/deflecomp/kp_*\nstiffness posterior / execution\nnon-SE(3) application state"
      ];
      frame_publishers [
        fillcolor="#ede9fe",
        label="ref / cmd / equil\nrobot_state_publisher\n+ static anchors"
      ];
      deflecomp_tf [
        shape=ellipse,
        fillcolor="white",
        label="actual /tf + /tf_static\nchild prefixes ref,cmd,equil"
      ];
      scoped_bridge [
        fillcolor="#ddd6fe",
        label="/deflecomp/probtf_bridge\nTF import=true\nTF export=false"
      ];
      scoped_dynamic [
        shape=ellipse,
        fillcolor="#ddd6fe",
        label="/deflecomp/probtf\nscoped dynamic v2 records"
      ];
      scoped_static [
        shape=ellipse,
        fillcolor="#ddd6fe",
        label="/deflecomp/probtf_static\nscoped latched static set"
      ];
      point_consumer [
        fillcolor="#ede9fe",
        label="RosProbTfListener\nLATEST_COMMON path\ntip-origin point moments"
      ];
      deflecomp_marker [
        shape=ellipse,
        fillcolor="#ede9fe",
        label="/deflecomp/probtf_point_moments\nMarkerArray mean + covariance axes"
      ];
      stiffness_guard [
        shape=octagon,
        color="#dc2626",
        fontcolor="#991b1b",
        fillcolor="#fef2f2",
        label="Forbidden\nDo not encode stiffness as SE(3)"
      ];

      deflecomp_control -> stiffness_topics;
      deflecomp_control -> frame_publishers [label="joint states"];
      frame_publishers -> deflecomp_tf [penwidth=2.0];
      deflecomp_tf -> scoped_bridge [penwidth=2.0, label="deterministic TF import"];
      scoped_bridge -> scoped_dynamic [penwidth=2.0];
      scoped_bridge -> scoped_static [penwidth=2.0];
      scoped_dynamic -> point_consumer;
      scoped_static -> point_consumer;
      point_consumer -> deflecomp_marker [penwidth=2.0, label="terminal visualization"];
      stiffness_topics -> stiffness_guard [color="#dc2626", arrowhead=tee];
      stiffness_guard -> scoped_dynamic [style=dashed, color="#dc2626", arrowhead=none, label="never registered"];
    }

    terminal_guard [
      shape=octagon,
      color="#dc2626",
      fontcolor="#991b1b",
      fillcolor="#fef2f2",
      label="Terminal summaries only\nDo not reinsert point moments,\ndisplay samples, or representatives"
    ];
    visualizers -> terminal_guard [color="#dc2626", arrowhead=tee];
    point_consumer -> terminal_guard [color="#dc2626", arrowhead=tee];
    terminal_guard -> global_dynamic [style=dashed, color="#dc2626", arrowhead=none];
  }

  subgraph cluster_todo {
    label="Explicit remaining work (not a v1 migration gap)";
    color="#64748b";
    style="rounded,dashed";

    todo_numerics [
      shape=note,
      fillcolor="#f1f5f9",
      label="Numerical backends\nexact finite-Bingham induced density\ncoupled numerical point action\nstochastic inverse analytic moments\ndependency-aware repeated-latent evaluation\nclosed-mixture reduction"
    ];
    todo_time [
      shape=note,
      fillcolor="#f1f5f9",
      label="Temporal models\nINTERPOLATE_WITH_MODEL\nPREDICT_WITH_MODEL\nlong-run authority policy"
    ];
    todo_runtime [
      shape=note,
      fillcolor="#f1f5f9",
      label="Runtime validation\nhigh-rate queue/history sizing\nmulti-process long-run consistency\nshared diagnostics UI\nX-enabled viewer visual smoke"
    ];

    todo_numerics -> kernels [style=dashed, arrowhead=none];
    todo_time -> graph_core [style=dashed, arrowhead=none];
    todo_runtime -> local_listener [style=dashed, arrowhead=none];
  }
}
