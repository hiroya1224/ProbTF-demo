Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Expanded:
      - /2D Pose Estimate1
      - /2D Nav Goal1
      - /Publish Point1
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
    - Alpha: 0.75
      Axis Length: 0.08
      Class: probtf_rviz/ProbabilisticTF
      Dynamic Snapshot Topic: /probtf_batch
      Dynamic Topic: /probtf
      Enabled: true
      Name: Probabilistic TF
      Point Size: 0.006
      Point Style: Spheres
      Queue Size: 10
      Random Seed: 29
      Representative Radius: 0.004
      Root Frame: ""
      Sample Count: 80
      Show Representatives: true
      Static Topic: /probtf_static
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 2.0
      Focal Point:
        X: 0
        Y: 0
        Z: 0.35
      Name: Current View
      Pitch: 0.45
      Target Frame: <Fixed Frame>
      Yaw: 0.75
Window Geometry:
  Height: 846
  Width: 1200
