<?xml version="1.0"?>
<package format="2">
  <name>deflecomp_sim</name>
  <version>0.1.0</version>
  <description>Simulation package for deflection compensation experiments.</description>

  <maintainer email="leus@todo.todo">leus</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>deflecomp_core</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>rospy</build_depend>
  <build_depend>sensor_msgs</build_depend>

  <build_export_depend>deflecomp_core</build_export_depend>
  <build_export_depend>geometry_msgs</build_export_depend>
  <build_export_depend>rospy</build_export_depend>
  <build_export_depend>sensor_msgs</build_export_depend>

  <exec_depend>deflecomp_core</exec_depend>
  <exec_depend>deflecomp_description</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-rospkg</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <export />
</package>
