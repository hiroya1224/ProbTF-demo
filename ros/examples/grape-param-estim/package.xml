<?xml version="1.0"?>
<package format="2">
  <name>grape_param_estim</name>
  <version>1.0.0</version>
  <description>Sparse batch trajectory estimation, Laplace-EM, and posterior parameter sampling for the Grape closed-loop system.</description>

  <maintainer email="leus@todo.todo">leus</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rosbag</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>dynamic_reconfigure</exec_depend>
  <exec_depend>aerial_robot_msgs</exec_depend>
  <exec_depend>spinal</exec_depend>

  <test_depend>python3-nose</test_depend>

  <export />
</package>
