<launch>
  <!-- Set start_camera:=false to use usb_cam or another external ROS driver. -->
  <arg name="start_camera" default="true" />
  <arg name="video_device" default="/dev/video0" />
  <arg name="image_width" default="640" />
  <arg name="image_height" default="480" />
  <arg name="framerate" default="30.0" />
  <arg name="fourcc" default="MJPG" />
  <arg name="camera_name" default="prob_artag_camera" />
  <arg name="camera_info_url" default="" />
  <arg name="fallback_horizontal_fov_deg" default="60.0" />

  <arg name="camera_link_frame" default="camera_link" />
  <arg name="camera_frame_id" default="camera_optical_frame" />
  <arg name="publish_camera_tf" default="true" />
  <arg name="image_topic" default="/prob_artag_camera/image_raw" />
  <arg name="camera_info_topic" default="/prob_artag_camera/camera_info" />
  <arg name="calibration_status_topic" default="/prob_artag_camera/calibration_status" />
  <arg name="probtf_topic" default="/prob_artag_demo/probtf" />
  <arg name="config" default="$(find prob_artag_detector)/config/default.yaml" />

  <arg name="export_representative_tf" default="true" />
  <arg name="rviz" default="true" />
  <arg name="rviz_config" default="$(find prob_artag_detector)/rviz/prob_artag_real_camera_demo.rviz" />

  <node
    if="$(arg start_camera)"
    pkg="prob_artag_detector"
    type="prob_artag_camera_demo_node.py"
    name="prob_artag_camera"
    output="screen"
    required="true">
    <param name="video_device" value="$(arg video_device)" />
    <param name="image_width" value="$(arg image_width)" />
    <param name="image_height" value="$(arg image_height)" />
    <param name="framerate" value="$(arg framerate)" />
    <param name="fourcc" value="$(arg fourcc)" />
    <param name="camera_name" value="$(arg camera_name)" />
    <param name="camera_info_url" value="$(arg camera_info_url)" />
    <param name="camera_frame_id" value="$(arg camera_frame_id)" />
    <param name="fallback_horizontal_fov_deg" value="$(arg fallback_horizontal_fov_deg)" />
    <remap from="~image_raw" to="$(arg image_topic)" />
    <remap from="~camera_info" to="$(arg camera_info_topic)" />
    <remap from="~calibration_status" to="$(arg calibration_status_topic)" />
  </node>

  <!-- REP-103 camera_link (x forward, y left, z up) to optical frame. -->
  <node
    if="$(arg publish_camera_tf)"
    pkg="tf2_ros"
    type="static_transform_publisher"
    name="prob_artag_camera_optical_tf"
    args="0 0 0 -0.5 0.5 -0.5 0.5 $(arg camera_link_frame) $(arg camera_frame_id)" />

  <include file="$(find prob_artag_detector)/launch/prob_artag_detector.launch">
    <arg name="image_topic" value="$(arg image_topic)" />
    <arg name="camera_info_topic" value="$(arg camera_info_topic)" />
    <arg name="calibration_status_topic" value="$(arg calibration_status_topic)" />
    <arg name="probtf_topic" value="$(arg probtf_topic)" />
    <arg name="publish_debug_image" value="true" />
    <arg name="publish_markers" value="true" />
    <arg name="camera_frame_id" value="$(arg camera_frame_id)" />
    <arg name="fallback_calibration_enabled" value="true" />
    <arg name="fallback_camera_frame_id" value="$(arg camera_frame_id)" />
    <arg name="fallback_horizontal_fov_deg" value="$(arg fallback_horizontal_fov_deg)" />
    <arg name="require_calibration_resolution_match" value="true" />
    <arg name="config" value="$(arg config)" />
  </include>

  <!-- This TF is a visualization-only, lossy projection of the full mixture. -->
  <group ns="prob_artag_demo">
    <include if="$(arg export_representative_tf)" file="$(find probtf_core)/launch/probtf_bridge.launch">
      <arg name="import_tf" value="false" />
      <arg name="export_tf" value="true" />
      <arg name="tf_export_policy" value="highest_weight_component_mode" />
      <arg name="probtf_topic" value="$(arg probtf_topic)" />
    </include>
  </group>

  <node
    if="$(arg rviz)"
    pkg="rviz"
    type="rviz"
    name="prob_artag_rviz"
    args="-d $(arg rviz_config)"
    required="false">
    <!-- Keep the fixed RViz config compatible with probtf_topic overrides. -->
    <remap from="/prob_artag_demo/probtf" to="$(arg probtf_topic)" />
  </node>
</launch>
