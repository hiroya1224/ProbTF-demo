Panels:
  - Class: rviz/Displays
    Help Height: 75
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Camera Grid1
        - /Tag Frames1
        - /Probabilistic AprilTags1
        - /Probabilistic Tag Modes1
        - /Detection Image1
        - /TF1
      Splitter Ratio: 0.5
    Tree Height: 247
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.44999998807907104
      Cell Size: 0.10000000149011612
      Class: rviz/Grid
      Color: 110; 118; 128
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Camera Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: camera_link
      Value: true
    - Class: rviz/TF
      Enabled: true
      Filter (blacklist): ""
      Filter (whitelist): ""
      Frame Timeout: 2
      Frames:
        All Enabled: true
        apriltag_12:
          Value: true
        camera_link:
          Value: true
        camera_optical_frame:
          Value: true
      Marker Alpha: 0.8500000238418579
      Marker Scale: 0.25
      Name: Tag Frames
      Show Arrows: true
      Show Axes: false
      Show Names: true
      Tree:
        camera_link:
          camera_optical_frame:
            apriltag_12:
              {}
      Update Interval: 0
      Value: true
    - Alpha: 0.6000000238418579
      Axis Length: 0.10000000149011612
      Class: probtf_rviz/ProbabilisticTF
      Dynamic Snapshot Topic: ""
      Dynamic Topic: /prob_artag_demo/probtf
      Enabled: true
      Frame Timeout: 2
      Name: Probabilistic AprilTags
      Point Size: 0.003000000026077032
      Point Style: Spheres
      Queue Size: 10
      Random Seed: 21
      Representative Radius: 0.003000000026077032
      Root Frame: camera_optical_frame
      Sample Count: 600
      Show Representatives: true
      Static Topic: ""
      Value: true
    - Class: rviz/MarkerArray
      Enabled: false
      Marker Topic: /prob_artag_detector/markers
      Name: Probabilistic Tag Modes
      Namespaces:
        {}
      Queue Size: 10
      Value: false
    - Class: rviz/Image
      Enabled: true
      Image Topic: /prob_artag_detector/debug_image
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Detection Image
      Normalize Range: true
      Queue Size: 2
      Transport Hint: raw
      Unreliable: false
      Value: true
    - Class: rviz/TF
      Enabled: true
      Filter (blacklist): ""
      Filter (whitelist): ""
      Frame Timeout: 15
      Frames:
        All Enabled: true
        apriltag_12:
          Value: true
        camera_link:
          Value: true
        camera_optical_frame:
          Value: true
      Marker Alpha: 0.33000001311302185
      Marker Scale: 0.10000000149011612
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Tree:
        camera_link:
          camera_optical_frame:
            apriltag_12:
              {}
      Update Interval: 0
      Value: true
  Enabled: true
  Global Options:
    Background Color: 34; 38; 44
    Default Light: true
    Fixed Frame: camera_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 1.7290983200073242
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Field of View: 0.7853981852531433
      Focal Point:
        X: 1.3773949146270752
        Y: -0.10362694412469864
        Z: -0.0852169543504715
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.03999999910593033
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.10499999672174454
      Target Frame: camera_link
      Yaw: 3.011594295501709
    Saved: ~
Window Geometry:
  Detection Image:
    collapsed: false
  Displays:
    collapsed: false
  Height: 1562
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Views:
    collapsed: false
  Width: 2826
  X: 830
