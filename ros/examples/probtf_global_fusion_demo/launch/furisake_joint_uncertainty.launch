<launch>
  <!--
    Dependency-aware flagship synthetic scene for ProbTF core >= 49adffcb.

    * Tou and Kasuga both start away from the initial shared keypoint pair.
    * Their six joint-zero offsets are Gaussian latent factors owned by
      probtf_core, not by the demo.
    * Shared keypoints add one atomic cross-robot Gaussian observation factor.
    * Both eye-in-hand cameras pursue the same information target with a common
      progress fraction, so their exploratory motion is simultaneous.
    * More keypoints remain after global orientation localization, allowing the
      joint posterior to keep shrinking rather than ending at moon_2.
  -->

  <arg name="start_rviz" default="true" />
  <arg name="publish_rate" default="20.0" />
  <arg name="sample_count" default="500" />
  <arg name="landmark_count" default="9" />
  <arg name="concentration" default="45.0" />
  <arg name="true_yaw_deg" default="55.0" />

  <!-- Both robots move from the first frame; Kasuga is deliberately far away. -->
  <arg name="tou_initial_gaze_yaw_offset_deg" default="-55.0" />
  <arg name="kasuga_initial_gaze_yaw_offset_deg" default="125.0" />
  <arg name="gaze_speed_deg" default="16.0" />
  <arg name="motion_cost_weight" default="0.08" />
  <arg name="joint_information_weight" default="0.65" />
  <arg name="active_start_delay" default="0.8" />

  <arg name="joint_prior_sigma_deg" default="1.5" />
  <arg name="joint_bearing_noise_deg" default="0.45" />
  <arg name="camera_hfov_deg" default="56.0" />
  <arg name="camera_vfov_deg" default="65.0" />

  <node pkg="probtf_global_fusion_demo"
        type="furisake_dependency_demo_node.py"
        name="global_fusion_demo"
        output="screen">
    <param name="publish_rate" value="$(arg publish_rate)" />
    <param name="sample_count" value="$(arg sample_count)" />
    <param name="landmark_count" value="$(arg landmark_count)" />
    <param name="concentration" value="$(arg concentration)" />
    <param name="true_yaw_deg" value="$(arg true_yaw_deg)" />
    <param name="tou_initial_gaze_yaw_offset_deg" value="$(arg tou_initial_gaze_yaw_offset_deg)" />
    <param name="kasuga_initial_gaze_yaw_offset_deg" value="$(arg kasuga_initial_gaze_yaw_offset_deg)" />
    <param name="gaze_speed_deg" value="$(arg gaze_speed_deg)" />
    <param name="motion_cost_weight" value="$(arg motion_cost_weight)" />
    <param name="joint_information_weight" value="$(arg joint_information_weight)" />
    <param name="active_start_delay" value="$(arg active_start_delay)" />
    <param name="joint_prior_sigma_deg" value="$(arg joint_prior_sigma_deg)" />
    <param name="joint_bearing_noise_deg" value="$(arg joint_bearing_noise_deg)" />
    <param name="camera_hfov_deg" value="$(arg camera_hfov_deg)" />
    <param name="camera_vfov_deg" value="$(arg camera_vfov_deg)" />
    <rosparam param="tou_arm_joints_deg">[15.0, -30.0, 70.0]</rosparam>
    <rosparam param="kasuga_arm_joints_deg">[150.0, -25.0, 60.0]</rosparam>
  </node>

  <!-- Keep the historical node name so the existing RViz private topics work. -->
  <node if="$(arg start_rviz)"
        pkg="rviz"
        type="rviz"
        name="rviz"
        args="-d $(find probtf_global_fusion_demo)/rviz/global_fusion_demo.rviz"
        output="screen" />
</launch>
