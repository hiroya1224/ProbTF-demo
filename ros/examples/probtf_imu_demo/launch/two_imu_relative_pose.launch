<launch>
  <arg name="parent_imu_topic" default="/imu_parent/data" />
  <arg name="child_imu_topic" default="/imu_child/data" />
  <arg name="materialize_urdf" default="true" />
  <arg name="probtf_topic" default="/probtf" />

  <node pkg="probtf_imu_demo" type="sensor_mount_tf_node.py" name="sensor_mount_tf" output="screen">
    <param name="config_file" value="$(find probtf_imu_demo)/config/sensor_mounts.yaml" />
  </node>

  <node pkg="probtf_imu_demo" type="imu_kinematics_node.py" name="parent_imu_kinematics" output="screen">
    <param name="frame_id" value="imu_parent" />
    <remap from="~imu" to="$(arg parent_imu_topic)" />
  </node>

  <node pkg="probtf_imu_demo" type="imu_kinematics_node.py" name="child_imu_kinematics" output="screen">
    <param name="frame_id" value="imu_child" />
    <remap from="~imu" to="$(arg child_imu_topic)" />
  </node>

  <node pkg="probtf_imu_demo" type="imu_relative_pose_node.py" name="imu_relative_pose" output="screen">
    <param name="parent_frame_id" value="imu_parent" />
    <param name="child_frame_id" value="imu_child" />
    <remap from="~parent_kinematics" to="/parent_imu_kinematics/kinematics" />
    <remap from="~child_kinematics" to="/child_imu_kinematics/kinematics" />
    <remap from="~relative_pose" to="$(arg probtf_topic)" />
  </node>

  <node
    if="$(arg materialize_urdf)"
    pkg="probtf_imu_demo"
    type="symbolic_urdf_materializer_node.py"
    name="symbolic_urdf_materializer"
    output="screen">
    <param name="template_file" value="$(find probtf_imu_demo)/symbolic_models/two_imus.symburdf" />
    <param name="input_topic" value="$(arg probtf_topic)" />
    <param name="parent_frame_id" value="imu_parent" />
    <param name="child_frame_id" value="imu_child" />
    <rosparam param="bindings">
      imu_relative_xyz:
        field: position
      imu_relative_rpy:
        field: orientation_rpy
    </rosparam>
  </node>

  <node if="$(arg materialize_urdf)" pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" />
</launch>
