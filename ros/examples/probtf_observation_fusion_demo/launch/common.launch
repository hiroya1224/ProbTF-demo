<launch>
  <arg name="observations" />
  <arg name="common" default="$(find probtf_observation_fusion_demo)/config/common.yaml" />
  <arg name="rviz" default="true" />
  <arg name="moving" default="true" />
  <arg name="execution_mode" default="live" />
  <arg name="imu_target_link" default="" />
  <arg name="max_updates" default="0" />
  <arg name="entry" default="$(eval 'observation_fusion_motion.py' if arg('moving') else 'observation_fusion_demo.py')" />
  <arg name="rviz_config" default="$(eval find('probtf_observation_fusion_demo') + '/rviz/' + ('observation_fusion_motion.rviz' if arg('moving') else 'observation_fusion_demo.rviz'))" />
  <arg name="autostart" default="true" />
  <arg name="stage_seconds" default="3.0" />
  <arg name="output_dir" default="/tmp/probtf_observation_fusion_demo/$(anon run)" />
  <param if="$(arg moving)" name="/observation_fusion/robot_description"
         command="/usr/bin/python3 $(find probtf_observation_fusion_demo)/scripts/print_motion_robot.py" />
  <node pkg="probtf_observation_fusion_demo" type="$(arg entry)"
        name="observation_fusion_demo" output="screen" required="true">
    <env name="OPENBLAS_NUM_THREADS" value="1" />
    <env name="OMP_NUM_THREADS" value="1" />
    <param name="common_config" value="$(arg common)" />
    <param name="observations_config" value="$(arg observations)" />
    <param name="output_dir" value="$(arg output_dir)" />
    <param name="autostart" value="$(arg autostart)" />
    <param name="execution_mode" value="$(arg execution_mode)" />
    <param name="imu_target_link" value="$(arg imu_target_link)" />
    <param name="max_updates" value="$(arg max_updates)" />
    <param name="stage_seconds" value="$(arg stage_seconds)" />
  </node>
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="observation_fusion_rviz"
        args="-d $(arg rviz_config)"
        output="screen" />
</launch>
