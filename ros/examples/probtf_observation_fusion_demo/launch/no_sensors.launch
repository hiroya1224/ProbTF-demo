<launch>
  <arg name="rviz" default="true" />
  <arg name="moving" default="true" />
  <arg name="execution_mode" default="simple" />
  <arg name="body_surprise" default="" />
  <arg name="marker_occlusion" default="" />
  <arg name="autostart" default="true" />
  <arg name="max_updates" default="0" />
  <arg name="stage_seconds" default="3.0" />
  <arg name="output_dir" default="/tmp/probtf_observation_fusion_demo/$(anon run)" />
  <include file="$(find probtf_observation_fusion_demo)/launch/common.launch">
    <arg name="observations" value="$(find probtf_observation_fusion_demo)/config/no_sensors.yaml" />
    <arg name="rviz" value="$(arg rviz)" />
    <arg name="moving" value="$(arg moving)" />
    <arg name="execution_mode" value="$(arg execution_mode)" />
    <arg name="body_surprise" value="$(arg body_surprise)" />
    <arg name="marker_occlusion" value="$(arg marker_occlusion)" />
    <arg name="autostart" value="$(arg autostart)" />
    <arg name="max_updates" value="$(arg max_updates)" />
    <arg name="stage_seconds" value="$(arg stage_seconds)" />
    <arg name="output_dir" value="$(arg output_dir)" />
  </include>
</launch>
