<?xml version="1.0"?>
<package format="2">
  <name>probtf_switch_press_demo</name>
  <version>0.1.0</version>
  <description>Image feedback and uncertain flexible-body predictions for a rod reaching a switch.</description>
  <maintainer email="leus@todo.todo">leus</maintainer>
  <license>MIT</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>deflecomp_core</depend>
  <depend>prob_artag_detector</depend>
  <depend>probtf_core</depend>
  <depend>probtf_msgs</depend>
  <exec_depend>probtf_rviz</exec_depend>
  <depend>symaware_grasp</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>visualization_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>python3-pytest</test_depend>
</package>
