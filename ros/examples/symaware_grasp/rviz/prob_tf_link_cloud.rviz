Panels:
  - Class: rviz/Displays
    Help Height: 75
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Robot Model1
        - /Prob-TF Link Cloud1
      Splitter Ratio: 0.5
    Tree Height: 620
  - Class: rviz/Views
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Class: rviz/Grid
      Color: 164; 168; 172
      Enabled: true
      Name: Grid
      Plane Cell Count: 14
      Plane: XY
      Reference Frame: base_link
      Value: true
    - Alpha: 1
      Class: rviz/RobotModel
      Collision Enabled: false
      Enabled: true
      Name: Robot Model
      Robot Description: robot_description
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: true
      Name: Prob-TF Link Cloud
      Position Transformer: XYZ
      Queue Size: 2
      Selectable: true
      Size (Pixels): 4
      Size (m): 0.01
      Style: Flat Squares
      Topic: /prob_tf_link_cloud
      Use Fixed Frame: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 244; 243; 239
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
    - Class: rviz/SetGoal
    - Class: rviz/PublishPoint
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 2.0
      Focal Point:
        X: 0.42
        Y: 0.0
        Z: 0.35
      Name: Current View
      Pitch: 0.48
      Target Frame: base_link
      Yaw: 0.98
Window Geometry:
  Displays:
    collapsed: false
  Height: 960
  Width: 1440
  X: 120
  Y: 40
