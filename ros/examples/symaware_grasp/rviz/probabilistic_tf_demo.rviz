Panels:
  - Class: rviz/Displays
    Help Height: 75
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Robot Model1
        - /Object Uncertainty1
        - /Hand Uncertainty1
        - /Selected Grasp1
      Splitter Ratio: 0.5
    Tree Height: 660
  - Class: rviz/Views
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.55
      Class: rviz/Grid
      Color: 164; 168; 172
      Enabled: true
      Name: Grid
      Plane Cell Count: 14
      Plane: XY
      Reference Frame: base_link
      Value: true
    - Alpha: 1
      Class: rviz/RobotModel
      Collision Enabled: false
      Enabled: true
      Name: Robot Model
      Robot Description: robot_description
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: true
      Name: Object Uncertainty
      Position Transformer: XYZ
      Queue Size: 2
      Selectable: true
      Size (Pixels): 4
      Size (m): 0.01
      Style: Flat Squares
      Topic: /object_axes_cloud
      Use Fixed Frame: true
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /object_mode_axes
      Name: Object Mode
      Queue Size: 2
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: true
      Name: Hand Uncertainty
      Position Transformer: XYZ
      Queue Size: 2
      Selectable: true
      Size (Pixels): 4
      Size (m): 0.01
      Style: Flat Squares
      Topic: /hand_axes_cloud
      Use Fixed Frame: true
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /hand_mode_axes
      Name: Hand Mode
      Queue Size: 2
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: true
      Name: Selected Grasp
      Position Transformer: XYZ
      Queue Size: 2
      Selectable: true
      Size (Pixels): 4
      Size (m): 0.012
      Style: Flat Squares
      Topic: /selected_grasp_axes_cloud
      Use Fixed Frame: true
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /selected_grasp_mode_axes
      Name: Selected Grasp Mode
      Queue Size: 2
      Value: true
  Enabled: true
  Global Options:
    Background Color: 244; 243; 239
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
    - Class: rviz/SetGoal
    - Class: rviz/PublishPoint
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 2.15
      Focal Point:
        X: 0.36
        Y: 0.02
        Z: 0.44
      Name: Current View
      Pitch: 0.42
      Target Frame: base_link
      Yaw: 0.92
Window Geometry:
  Displays:
    collapsed: false
  Height: 980
  Width: 1480
  X: 120
  Y: 40
