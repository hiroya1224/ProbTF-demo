<?xml version="1.0"?>
<robot name="simple_six_dof_arm">
  <material name="graphite">
    <color rgba="0.23 0.25 0.29 1.0"/>
  </material>
  <material name="silver">
    <color rgba="0.75 0.76 0.78 1.0"/>
  </material>
  <material name="signal_orange">
    <color rgba="0.95 0.45 0.12 1.0"/>
  </material>
  <material name="tool_blue">
    <color rgba="0.17 0.45 0.78 1.0"/>
  </material>
  <material name="gripper_metal">
    <color rgba="0.16 0.18 0.22 1.0"/>
  </material>
  <material name="gripper_pad">
    <color rgba="0.08 0.08 0.09 1.0"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.28 0.28 0.12"/>
      </geometry>
      <material name="graphite"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.28 0.28 0.12"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <mass value="8.0"/>
      <inertia ixx="0.08" ixy="0.0" ixz="0.0" iyy="0.08" iyz="0.0" izz="0.08"/>
    </inertial>
  </link>

  <link name="link_1">
    <visual>
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.18"/>
      </geometry>
      <material name="signal_orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.18"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <mass value="3.0"/>
      <inertia ixx="0.02" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="80.0" velocity="1.5"/>
  </joint>

  <link name="link_2">
    <visual>
      <origin xyz="0.18 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.36 0.09 0.09"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0.18 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.36 0.09 0.09"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.18 0 0" rpy="0 0 0"/>
      <mass value="4.0"/>
      <inertia ixx="0.02" ixy="0.0" ixz="0.0" iyy="0.12" iyz="0.0" izz="0.12"/>
    </inertial>
  </link>

  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 0.18" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.3562" upper="2.3562" effort="80.0" velocity="1.5"/>
  </joint>

  <link name="link_3">
    <visual>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.30 0.08 0.08"/>
      </geometry>
      <material name="signal_orange"/>
    </visual>
    <collision>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.30 0.08 0.08"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
      <mass value="3.0"/>
      <inertia ixx="0.015" ixy="0.0" ixz="0.0" iyy="0.08" iyz="0.0" izz="0.08"/>
    </inertial>
  </link>

  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0.36 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.7925" upper="2.7925" effort="60.0" velocity="1.8"/>
  </joint>

  <link name="link_4">
    <visual>
      <origin xyz="0.07 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.14"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0.07 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.14"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.07 0 0" rpy="0 1.5708 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.003" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0.30 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="40.0" velocity="2.0"/>
  </joint>

  <link name="link_5">
    <visual>
      <origin xyz="0.06 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.12"/>
      </geometry>
      <material name="signal_orange"/>
    </visual>
    <collision>
      <origin xyz="0.06 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.12"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.06 0 0" rpy="0 1.5708 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.006" iyz="0.0" izz="0.006"/>
    </inertial>
  </link>

  <joint name="joint_5" type="revolute">
    <parent link="link_4"/>
    <child link="link_5"/>
    <origin xyz="0.14 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.3562" upper="2.3562" effort="30.0" velocity="2.0"/>
  </joint>

  <link name="link_6">
    <visual>
      <origin xyz="0.05 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.032" length="0.10"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0.05 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.032" length="0.10"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.05 0 0" rpy="0 1.5708 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.0015" ixy="0.0" ixz="0.0" iyy="0.004" iyz="0.0" izz="0.004"/>
    </inertial>
  </link>

  <joint name="joint_6" type="revolute">
    <parent link="link_5"/>
    <child link="link_6"/>
    <origin xyz="0.12 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="20.0" velocity="2.5"/>
  </joint>

  <link name="tool0">
    <!-- The tool0 origin is the grasp center used by the IK solver. -->
    <visual name="gripper_palm">
      <origin xyz="-0.09 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.17 0.12"/>
      </geometry>
      <material name="tool_blue"/>
    </visual>
    <visual name="gripper_left_finger">
      <origin xyz="-0.005 0.071 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.13 0.025 0.14"/>
      </geometry>
      <material name="gripper_metal"/>
    </visual>
    <visual name="gripper_right_finger">
      <origin xyz="-0.005 -0.071 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.13 0.025 0.14"/>
      </geometry>
      <material name="gripper_metal"/>
    </visual>
    <visual name="gripper_left_pad">
      <origin xyz="0.015 0.0555 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.006 0.11"/>
      </geometry>
      <material name="gripper_pad"/>
    </visual>
    <visual name="gripper_right_pad">
      <origin xyz="0.015 -0.0555 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.006 0.11"/>
      </geometry>
      <material name="gripper_pad"/>
    </visual>
    <collision name="gripper_palm_collision">
      <origin xyz="-0.09 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.17 0.12"/>
      </geometry>
    </collision>
    <collision name="gripper_left_finger_collision">
      <origin xyz="-0.005 0.071 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.13 0.025 0.14"/>
      </geometry>
    </collision>
    <collision name="gripper_right_finger_collision">
      <origin xyz="-0.005 -0.071 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.13 0.025 0.14"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.04 0 0" rpy="0 0 0"/>
      <mass value="0.7"/>
      <inertia ixx="0.0015" ixy="0.0" ixz="0.0" iyy="0.0020" iyz="0.0" izz="0.0020"/>
    </inertial>
  </link>

  <joint name="tool0_joint" type="fixed">
    <parent link="link_6"/>
    <child link="tool0"/>
    <origin xyz="0.10 0 0" rpy="0 0 0"/>
  </joint>
</robot>
